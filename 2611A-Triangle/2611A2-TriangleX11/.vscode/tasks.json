{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Vulkan Triangle (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build", "-DCMAKE_BUILD_TYPE=Debug"],
      "problemMatcher": []
    },
    {
      "label": "Build Vulkan Triangle (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--config", "Debug", "--parallel"],
      "dependsOn": "Configure Vulkan Triangle (Debug)",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
